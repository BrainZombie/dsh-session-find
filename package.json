{
  "name": "dsh-session-find",
  "version": "0.1.0",
  "description": "Fast, local cross-session search for DSH: persistent SQLite FTS5 index over session transcripts, with redaction. Replaces the unusable session_search on large session histories.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainZombie/dsh-session-find.git"
  },
  "homepage": "https://github.com/BrainZombie/dsh-session-find#readme",
  "bugs": {
    "url": "https://github.com/BrainZombie/dsh-session-find/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session-search",
    "sqlite",
    "fts5"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "doctor": "dsh-plugin doctor ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
